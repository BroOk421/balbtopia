{
  "name": "balbtopia",
  "version": "0.1.0",
  "private": true,
  "description": "Balbtopia - a Growtopia-style 2D block world. Web game (www/) wrapped for Android with Capacitor.",
  "scripts": {
    "serve": "npx http-server www -p 8080 -c-1",
    "sync": "npx cap sync android",
    "open:android": "npx cap open android",
    "android": "npx cap run android",
    "apk": "npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "6.2.2",
    "@capacitor/app": "6.0.3",
    "@capacitor/core": "6.2.2",
    "@capacitor/haptics": "6.0.3",
    "@capacitor/screen-orientation": "6.0.4",
    "@capacitor/status-bar": "6.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.2"
  }
}
