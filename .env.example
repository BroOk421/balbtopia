# Copy this file to ".env" and fill it in (Supabase → Connect, or Project Settings → API Keys).
# .env is not uploaded to GitHub. Then run: npm run config
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# the anon / publishable key (sb_publishable_... or eyJhbGciOi...), NEVER the secret / service_role key
SUPABASE_ANON_KEY=

# (optional) your own realtime server's fixed address, e.g. wss://rt.yourdomain.com (rt-server/README.md).
# Leave it empty with the quick tunnel: the game finds the server through Supabase.
RT_URL=
