# Copy this file to ".env" and fill it in (Supabase → Connect, or Project Settings → API Keys).
# .env is not uploaded to GitHub. Then run: npm run config
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# the anon / publishable key (sb_publishable_... or eyJhbGciOi...), NEVER the secret / service_role key
SUPABASE_ANON_KEY=
